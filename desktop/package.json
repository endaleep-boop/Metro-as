{
  "name": "metro-as-istanbul",
  "version": "1.0.0",
  "description": "Metro A.Ş. – İstanbul",
  "main": "main.js",
  "author": "Metro A.Ş.",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.metroas.istanbul",
